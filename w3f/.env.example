# Gelato Web3 Function — environment template
# Copy to .env and fill in real values. DO NOT commit .env

# JSON-RPC provider URLs (chain ID → URL mapping)
PROVIDER_URLS={"11155111": "https://eth-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>"}

# Your Gelato API key — get it from https://app.gelato.network → Settings
GELATO_API_KEY=<your-gelato-api-key>

# NEAR testnet credentials — also set these as secrets in the Gelato dashboard
NEAR_ACCOUNT_ID=<yourname>.testnet
NEAR_PRIVATE_KEY=ed25519:<base58-private-key>
NEAR_RPC_URL=https://rpc.testnet.near.org
